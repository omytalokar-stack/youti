NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/dimag-ai
FRONTEND_URL=http://localhost:3000
GEMINI_API_KEY=
GEMINI_API_KEY_2=
# Optional comma-separated pool; entries are merged with the individual key variables.
GEMINI_API_KEYS=

YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:5000/api/youtube/oauth2callback
# The scheduler checks every 30 minutes and retries a failed daily public upload until it succeeds.
AUTOMATION_CRON=*/30 * * * *
# Start the daily publishing cycle at 4 PM in the configured timezone.
AUTOMATION_START_HOUR=16
# Set AUTOMATION_CRON=disabled to prevent scheduled publishing.
AUTOMATION_TIMEZONE=Asia/Kolkata
YOUTUBE_UPLOAD_PRIVACY=public
YOUTUBE_CATEGORY_ID=22
YOUTUBE_MADE_FOR_KIDS=false
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_TTS_VOICE=Puck
SUBTITLE_FONT=Noto Sans Devanagari
# Optional absolute executable paths when FFmpeg is not on PATH.
FFMPEG_PATH=
FFPROBE_PATH=

# Use a random secret of at least 32 characters.
OAUTH_STATE_SECRET=
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
YOUTUBE_TOKEN_ENCRYPTION_KEY=
