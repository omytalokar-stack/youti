{
  "name": "dimag-ai",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node --expose-gc --import tsx/esm server.js",
    "dev": "node ./node_modules/nodemon/bin/nodemon.js --watch .env --watch server.js --watch config --watch models --watch routes --watch services --ext js,json --exec \"node --import tsx/esm\" server.js",
    "dev:client": "node ./node_modules/vite/bin/vite.js --port=3000 --host=0.0.0.0",
    "build": "node ./node_modules/vite/bin/vite.js build",
    "preview": "node ./node_modules/vite/bin/vite.js preview",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "node ./node_modules/typescript/bin/tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "fluent-ffmpeg": "^2.1.3",
    "googleapis": "^189.0.0",
    "lucide-react": "^0.546.0",
    "mongoose": "^8.19.1",
    "morgan": "^1.10.1",
    "motion": "^12.23.24",
    "msedge-tts": "^2.1.1",
    "node-cron": "^4.6.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tsx": "^4.23.15",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.10",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "nodemon": "3.1.11",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
